# syntax=docker/dockerfile:1

# ── Stage 1: Angular build ─────────────────────────────────────────────────────
FROM node:22-alpine AS builder

ARG ANGULAR_CONFIG=production

WORKDIR /app

COPY web/frontend/package.json web/frontend/package-lock.json* web/frontend/bun.lock* ./
RUN npm ci --legacy-peer-deps --prefer-offline 2>/dev/null || npm install --legacy-peer-deps

COPY web/frontend/ ./

RUN npx ng build --configuration ${ANGULAR_CONFIG}

# ── Stage 2: Nginx runtime ────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

COPY --from=builder /app/dist/careertwin/browser /usr/share/nginx/html
COPY web/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
