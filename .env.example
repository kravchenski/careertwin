# CareerTwin AI — Environment Variables
# Copy to .env and fill in your values

## LLM Provider — at least one required

# Four-agent workflow: text generation and browser control through Switchyard.
SWITCHYARD_URL=http://127.0.0.1:3260
SWITCHYARD_MODEL=agent
SWITCHYARD_MCP_URL=http://127.0.0.1:3260/mcp
SWITCHYARD_API_KEY=
# Model for `careertwin agent` and MCP-driven agents (falls back to SWITCHYARD_MODEL, then auto)
SWITCHYARD_AGENT_MODEL=
# Where agent tools reach the CareerTwin API
CAREERTWIN_API_URL=http://127.0.0.1:8000
# Set to 1 to let an approved agent press submit on application forms
CAREERTWIN_AGENT_ALLOW_SUBMIT=
DECISION_BACKEND=switchyard
DECISION_MODEL=auto

# Optional: select decision_backend=typesafe in Agents to use hosted Jev.
TYPESAFE_API_KEY=

# LM Studio (local)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/api/v1/chat
LMSTUDIO_API_BASE=http://127.0.0.1:1234
LMSTUDIO_MODEL=qwythos-9b-v2

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:3b

# OpenAI (cloud)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (cloud)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

## The account the agents use (all optional)

# One account for everything: the email you apply with and sign in with. Keep this file private
# (chmod 600): `careertwin security` checks it. Secrets are never sent to a model; the agent writes a
# placeholder and the program types the password itself.
ACCOUNT_EMAIL=
ACCOUNT_PASSWORD=
# Sites where the agent may type ACCOUNT_PASSWORD (comma-separated). Empty = it never types it.
CAREERTWIN_LOGIN_DOMAINS=
# Extra sites where a form may be filled, besides the employer's own and the usual application systems
CAREERTWIN_FORM_DOMAINS=

## Interview assistant

# Model for live answer hints (falls back to SWITCHYARD_MODEL, then auto)
INTERVIEW_MODEL=
# faster-whisper model: base, small, medium, large-v3-turbo
CAREERTWIN_WHISPER_MODEL=small

## Data Sources

GITHUB_TOKEN=

## Web Search

SEARXNG_URL=http://localhost:8888
TAVILY_API_KEY=

## Application

# Token every API call must carry (Authorization: Bearer ...). Empty = a random one is written to
# data/api-token on the first start. If you set it, use 32+ random characters.
CAREERTWIN_API_TOKEN=
# Extra Host names the API answers to (comma-separated). Loopback names are always allowed.
CAREERTWIN_ALLOWED_HOSTS=
# Set to 1 to serve the interactive docs at /docs (they cannot send the token)
CAREERTWIN_API_DOCS=
# Docker only: password of the browser desktop (noVNC on 127.0.0.1:6080)
VNC_PASSWORD=

# Comma-separated browser origins allowed to call the API (empty = same-origin only)
CORS_ORIGINS=
CAREERTWIN_DB_PATH=data/careertwin.db
