# CareerTwin AI — Environment Variables

# GitHub API token (optional — public API used by default)
# Required for private repos and higher rate limits (5000 req/hour vs 60)
# Get one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Qdrant vector store (optional — local instance by default)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# OpenAI API key (required for embeddings in Phase 2)
# OPENAI_API_KEY=
